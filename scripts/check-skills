#!/usr/bin/env python3
"""Check the handbook: skills, secrets, links and layout.

Usage: scripts/check-skills [ROOT]   (default: the repository root)

Every problem is printed as `path:line: message` and the exit status is
1 when there is any. Standard library only, so it runs on the node's
image (python3) with nothing installed.

Rules:
  - every folder under skills/ holds a SKILL.md;
  - SKILL.md starts with YAML frontmatter (--- ... ---) whose `name` is
    its folder's name and whose `description` is at least 20 characters;
  - every other skills/<name>/<stack>.md (a stack variant) starts with
    frontmatter whose `stack` is <stack>;
  - no file holds a likely secret (AWS, GCP, GitHub, Anthropic, OpenAI
    keys, private keys);
  - every URL's host is listed in scripts/allowed-hosts.txt;
  - every file is under skills/, ways-of-working/, docs/, scripts/,
    .runsheet/ or .github/, or is one of the root documents.
"""
import os
import re
import subprocess
import sys

ALLOWED_DIRS = ("skills/", "ways-of-working/", "docs/", "scripts/", ".runsheet/", ".github/")
ROOT_FILES = {
    "README.md", "AGENTS.md", "CLAUDE.md", "CONTRIBUTING.md", "LICENSE",
    "NOTICE", "SECURITY.md", "CODE_OF_CONDUCT.md", ".gitignore", ".gitattributes",
}
# The checker's own test builds bad fixtures at run time; nothing here is
# exempt but this folder, which holds none committed.
SKIP_DIRS = ("scripts/testdata/",)
MIN_DESCRIPTION = 20

SECRETS = [
    ("AWS access key id", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("AWS secret access key", re.compile(r"aws_secret_access_key\s*[:=]\s*['\"]?[A-Za-z0-9/+]{40}")),
    ("GCP API key", re.compile(r"\bAIza[0-9A-Za-z_\-]{35}")),
    ("GCP service account key", re.compile(r"\"type\"\s*:\s*\"service_account\"")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}")),
    ("GitHub fine-grained token", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{22,}")),
    ("Anthropic API key", re.compile(r"\bsk-ant-[A-Za-z0-9_\-]{20,}")),
    ("OpenAI API key", re.compile(r"\bsk-(?!ant-)(?:proj-|svcacct-)?[A-Za-z0-9_\-]{20,}")),
    ("private key", re.compile(r"-----BEGIN (?:[A-Z]+ )*PRIVATE KEY-----")),
]
URL = re.compile(r"\bhttps?://([^/\s\"'<>()\[\]`]+)", re.IGNORECASE)
KEY = re.compile(r"^([A-Za-z_][A-Za-z0-9_-]*):(?:\s+(.*))?$")


def list_files(root):
    try:
        out = subprocess.run(
            ["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
            capture_output=True, check=True,
        ).stdout.decode()
        files = [f for f in out.split("\0") if f]
        return sorted(f for f in files if os.path.isfile(os.path.join(root, f)))
    except (OSError, subprocess.CalledProcessError):
        pass
    files = []
    for d, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if x != ".git"]
        for n in names:
            files.append(os.path.relpath(os.path.join(d, n), root).replace(os.sep, "/"))
    return sorted(files)


def unquote(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
        return v[1:-1]
    return v


def frontmatter(lines):
    """Parse leading frontmatter. Returns (fields, lines-of-each-key, error, error-line)."""
    if not lines or lines[0].rstrip("\r\n") != "---":
        return None, {}, "no frontmatter: the file must start with a --- line", 1
    fields, at, key = {}, {}, None
    for i, raw in enumerate(lines[1:], start=2):
        line = raw.rstrip("\r\n")
        if line == "---":
            return fields, at, None, None
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0] in " \t":
            if key is None:
                return None, {}, "malformed frontmatter: indented line with no key", i
            fields[key] = (fields[key] + " " + line.strip()).strip()
            continue
        m = KEY.match(line)
        if not m:
            return None, {}, "malformed frontmatter: expected `key: value`", i
        key, value = m.group(1), (m.group(2) or "").strip()
        if key in fields:
            return None, {}, "malformed frontmatter: %s given twice" % key, i
        fields[key] = "" if value in (">", "|", ">-", "|-") else unquote(value)
        at[key] = i
    return None, {}, "malformed frontmatter: no closing --- line", 1


def read_lines(path):
    with open(path, "rb") as f:
        data = f.read()
    if b"\0" in data:
        return None
    try:
        return data.decode("utf-8").splitlines(True)
    except UnicodeDecodeError:
        return None


def load_hosts(root):
    path = os.path.join(root, "scripts", "allowed-hosts.txt")
    hosts = set()
    if os.path.exists(path):
        for line in open(path, encoding="utf-8"):
            line = line.split("#", 1)[0].strip().lower()
            if line:
                hosts.add(line)
    return hosts


def check(root):
    problems = []

    def bad(path, line, msg):
        problems.append("%s:%d: %s" % (path, line, msg))

    files = [f for f in list_files(root) if not f.startswith(SKIP_DIRS)]
    hosts = load_hosts(root)

    for f in files:
        if "/" not in f:
            if f not in ROOT_FILES:
                bad(f, 1, "file outside the handbook's folders (skills/, ways-of-working/, docs/, scripts/, .runsheet/, .github/) and not a root document")
        elif not f.startswith(ALLOWED_DIRS):
            bad(f, 1, "file outside the handbook's folders (skills/, ways-of-working/, docs/, scripts/, .runsheet/, .github/)")

        lines = read_lines(os.path.join(root, f))
        if lines is None:
            continue
        for n, line in enumerate(lines, start=1):
            for what, rx in SECRETS:
                if rx.search(line):
                    bad(f, n, "likely secret (%s): remove it, and rotate it if it was real" % what)
            for m in URL.finditer(line):
                host = m.group(1).rsplit("@", 1)[-1].split(":", 1)[0].rstrip(".,;").lower()
                if host not in hosts:
                    bad(f, n, "URL host %s is not in scripts/allowed-hosts.txt" % host)

    skills = sorted({f.split("/")[1] for f in files if f.startswith("skills/") and f.count("/") >= 2})
    for name in skills:
        skill = "skills/%s/SKILL.md" % name
        if skill not in files:
            bad("skills/%s" % name, 1, "skill folder has no SKILL.md")
        else:
            fields, at, err, line = frontmatter(read_lines(os.path.join(root, skill)) or [])
            if err:
                bad(skill, line, err)
            else:
                if "name" not in fields:
                    bad(skill, 1, "frontmatter has no name")
                elif fields["name"] != name:
                    bad(skill, at["name"], "name %r does not match its folder %r" % (fields["name"], name))
                desc = fields.get("description", "")
                if not desc:
                    bad(skill, at.get("description", 1), "frontmatter has no description")
                elif len(desc) < MIN_DESCRIPTION:
                    bad(skill, at["description"], "description is under %d characters: say what the skill does and when to use it" % MIN_DESCRIPTION)
        for f in files:
            parts = f.split("/")
            if len(parts) == 3 and parts[1] == name and f.endswith(".md") and parts[2] != "SKILL.md":
                stack = parts[2][:-3]
                fields, at, err, line = frontmatter(read_lines(os.path.join(root, f)) or [])
                if err:
                    bad(f, line, err)
                elif fields.get("stack") != stack:
                    bad(f, at.get("stack", 1), "stack %r does not match the file name %r" % (fields.get("stack", ""), stack))
    return problems


def main(argv):
    root = argv[1] if len(argv) > 1 else os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
    problems = check(os.path.abspath(root))
    for p in problems:
        print(p)
    if problems:
        print("check-skills: %d problem(s)" % len(problems), file=sys.stderr)
        return 1
    print("check-skills: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
